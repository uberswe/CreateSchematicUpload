{
  "schemaVersion": 1,
  "id": "createschematichelper",
  "version": "${mod_version}",
  "name": "CreateSchematicHelper",
  "description": "Upload and download Create mod schematics to and from createmod.com.",
  "authors": [
    "uberswe",
    "Jamalam"
  ],
  "contact": {
    "homepage": "https://createmod.com",
    "sources": "https://github.com/uberswe/CreateSchematicUpload"
  },
  "license": "MIT",
  "icon": "assets/createschematichelper/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.uberswe.createschematichelper.fabric.CreateSchematicHelperFabric"
    ]
  },
  "mixins": [
    "createschematichelper.mixins.json",
    "createschematichelper.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "create": "*"
  }
}
